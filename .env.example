# Copy this file to .env before running docker-compose up.
# See README "Secrets in production" for how these should be managed
# outside of local dev (they should NOT be committed anywhere real).

# --- App ---
ENV=development
API_PORT=8088

# --- Database ---
# docker-compose overrides this to point at the `db` service; only
# relevant if you run the API outside docker-compose.
DATABASE_URL=postgresql+psycopg2://peblo:peblo@localhost:55432/peblo_tv_mini

# --- Auth (demo-simple: static API key -> role) ---
EDITOR_API_KEY=editor-key-change-me
ADMIN_API_KEY=admin-key-change-me

# --- Storage ---
# "local" (default, disk-backed) or "s3" (Cloudflare R2 / MinIO / any
# S3-compatible endpoint). Swapping is a one-line change -- see
# app/storage/base.py and README Part E.
STORAGE_BACKEND=local
STORAGE_ROOT=/data/storage

# Only used when STORAGE_BACKEND=s3
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=peblo-tv-mini
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_REGION=auto

# --- CORS ---
CORS_ORIGINS=http://localhost:5180,http://localhost:5190

# --- Frontend build-time vars (cms/.env and viewer/.env also read this) ---
VITE_API_BASE=http://localhost:8088
